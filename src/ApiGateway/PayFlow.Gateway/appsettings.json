{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Information"
      }
    }
  },
  "Observability": {
    "Seq": {
      "ServerUrl": "http://localhost:5341"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "Match": { "Path": "/api/transactions/{**catch-all}" }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-1": { "Address": "http://localhost:5001/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-1": { "Address": "http://localhost:5002/" }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "transaction-1": { "Address": "http://localhost:5003/" }
        }
      }
    }
  }
}
