{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Observability": {
    "Seq": {
      "ServerUrl": "http://localhost:5341"
    }
  },
  "Transaction": {
    "PaymentService": {
      "BaseUrl": "http://localhost:5002",
      "TimeoutSeconds": 30
    },
    "Routing": {
      "DefaultProvider": "stripe"
    }
  },
  "AllowedHosts": "*"
}
