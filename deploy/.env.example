# Copy to deploy/.env and fill in real values before running prod compose:
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build
#
# Anything left as a placeholder here is intentionally non-functional so a
# misconfigured deploy fails fast at startup instead of running on dev defaults.

# --- ASP.NET hosting ---------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# --- Postgres (single instance, multi-schema per ADR-0002) -------------------
POSTGRES_USER=payflow
POSTGRES_PASSWORD=__set_me__
POSTGRES_DB=payflow

# --- JWT issuance + validation contract --------------------------------------
# The committed dev key is rejected when ASPNETCORE_ENVIRONMENT=Production.
PAYFLOW_JWT_ISSUER=PayFlow.Identity
PAYFLOW_JWT_AUDIENCE=PayFlow.Services
# Must be >= 32 bytes for HS256.
PAYFLOW_JWT_SIGNING_KEY=__generate_me__a_real_signing_key_min_32_bytes__

# --- RabbitMQ (Notification retry queue + DLQ) -------------------------------
# Same broker that the Notification service connects to via
# RabbitMQ__ConnectionString = amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/
# Defaults match the bundled image. Override before any real deployment.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=__set_me__

# --- Grafana admin (observability dashboard) ---------------------------------
# Defaults to admin / admin if unset — fine for local-only deploys, replace
# anywhere reachable from outside localhost.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__set_me__

# --- Gateway port exposed on the host (everything else is in-network only) ---
GATEWAY_PUBLIC_PORT=5050
